* text=auto eol=lf

# The release archive is what the App adoption gate reads. It must ship CHARTER.md, README.md,
# CHANGELOG.md, MIGRATION-HANDOFF.md, LICENSE, composer.json, docs/, examples/, resources/ and src/.
# Only development and repository plumbing is excluded.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.phpstan.cache export-ignore
/composer.lock export-ignore
/dist export-ignore
/phpcs.xml export-ignore
/phpstan.neon export-ignore
/tests export-ignore
/tools export-ignore
/vendor export-ignore
